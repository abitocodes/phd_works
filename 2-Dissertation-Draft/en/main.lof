\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces ERC-20 allowance lifecycle: approve (or permit), optional \texttt {transferFrom}, and revoke. EndorseRank edges reflect the latest live allowance snapshot per owner--spender pair (historical approvals superseded, not time-decayed).}}{30}{figure.caption.28}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Random-surfer intuition for PageRank. Solid arrows are graph transitions; dashed arrows represent teleportation that mixes the chain.}}{32}{figure.caption.32}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Conceptual model: primary EndorseRank vs.\ AWP comparison mapped to reputation structure (H1/RQ1), social-method alignment (H2/RQ2), and computational efficiency (H3/RQ3); RQ4 separately compares transfer versus trading-success validation frames. GF-PR (dashed) is a supplementary outcome-native ceiling reference (SRQ1), not a third peer social method.}}{37}{figure.caption.41}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Evaluation pipeline: public Arbitrum logs are extracted and decoded, reputation edges and GMX outcomes are preprocessed, EndorseRank and AWP ranks are computed, proxies and alignment statistics are evaluated, and LaTeX result fragments are exported.}}{51}{figure.caption.60}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Logistic time-decay $\sigma (\Delta t)$ used by AWP ($k=0.01$, $t_0=180$ days). Horizontal axis is event age in days before 2026-05-31 UTC; vertical axis is the multiplicative weight applied to transfer value.}}{56}{figure.caption.65}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Distribution of GMX V2 \texttt {PositionDecrease} close counts per wallet in the matched cohort ($n=5{,}521$). The cohort filter requires at least three closes; the long right tail reflects a minority of highly active traders.}}{74}{figure.caption.97}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Distribution of GMX realized PnL summaries in the matched cohort. Heterogeneous profit and loss outcomes motivate treating trading-success proxies as one validation axis among several, rather than as a sole ground truth for social reputation.}}{75}{figure.caption.98}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Distribution of GMX close success rates in the matched cohort. Concentration of rates reduces the discriminative power of rate-based trading-success proxies relative to count- or value-based proxies.}}{76}{figure.caption.99}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces PageRank wall-clock runtime versus cohort size (log $x$-axis). Solid lines: in-cohort scaling on the matched GMX sample ($n\leq 5{,}521$). Dashed lines: expanded wallet pool ($N=31{,}612$). EndorseRank remains approximately $9$--$10\times $ faster than AWP at $n=10{,}000$ ($\approx 10.4\times $) and at full pool size ($\approx 9.4\times $).}}{80}{figure.caption.104}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Damping sensitivity of mean Kendall $\tau $ for allowance and transfer families ($d \in \{0.75, 0.85, 0.95\}$). EndorseRank allowance alignment remains $\approx 0.355$ across the sweep; AWP transfer alignment varies by at most $\approx 0.005$.}}{82}{figure.caption.108}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Family-level mean Kendall $\tau $ heatmap for EndorseRank, AWP, and supplementary GF-PR on the matched cohort ($n=5{,}521$). EndorseRank peaks on allowance; AWP peaks on transfer among social methods; GF-PR peaks on trading-outcome families via construct overlap.}}{85}{figure.caption.115}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Marginal distributions of EndorseRank and AWP scores on the matched cohort ($n=5{,}521$), shown on a $\log _{10}$ scale for wallets with positive score (EndorseRank excludes $966$ zero-score wallets; AWP excludes $381$). Both are right-skewed PageRank distributions; differences in shape reflect the distinct endorsement and transfer operators.}}{94}{figure.caption.128}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Rank--rank scatter of EndorseRank versus AWP on the matched cohort. Inter-method Kendall $\tau =0.316$ indicates partial overlap with substantial pairwise disagreement, supporting H1/RQ1 (construct-distinct orderings).}}{95}{figure.caption.129}%
