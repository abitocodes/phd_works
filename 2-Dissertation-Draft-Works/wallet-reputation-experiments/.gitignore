.venv/
__pycache__/
*.pyc
*.sqlite3

# --- Blockchain data: track collected/processed artifacts by default ---
# Still exclude regenerable intermediates and blobs over GitHub's 100 MiB hard limit.

# Local extraction / eval run logs
data/**/*.log

# Partial BigQuery downloads (resume with --resume)
data/**/_chunks/

# Optional Tier-2 re-extract (~3.5 GiB); recreate via extract_reputation_data.py --tier2
data/raw/reputation_tier2/

# Active-wallet cache (sample_active_wallets.py); several months exceed 100 MiB
data/processed/active_wallet_cache/

# Single files over GitHub's 100 MiB hard limit (recreate via extract/preprocess scripts)
data/raw/gmx_event_logs_2025-12_to_2026-05.parquet
data/raw/reputation/transfers/transfers_arbitrum.parquet
data/processed/reputation/transfer_events.parquet

# results/ holds the committed evaluation summaries (see results/README.md)
!results/
